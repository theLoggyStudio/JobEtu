# URL de l’API (obligatoire en préprod/prod). Sans variable : défaut http://localhost:4000/api au build.
VITE_API_URL=http://localhost:4000/api

# Après inscription : origine du front pour la redirection (défaut https://job-etu.vercel.app). En dev local, mettre http://localhost:5173 pour conserver le jeton dans le même navigateur.
# VITE_POST_REGISTER_APP_ORIGIN=https://job-etu.vercel.app
# Optionnel : même clé 64 hex que CLIENT_PAYLOAD_AES_KEY sur l’API (présente dans le bundle ; utiliser surtout avec HTTPS).
# VITE_CLIENT_PAYLOAD_AES_KEY=

# WhatsApp (liens publics, ex. https://wa.me/221771234567). Remplacez les numéros factices du code.
# VITE_ONEJOB_WHATSAPP_MEDA=
# VITE_ONEJOB_WHATSAPP_ADE_DANY=
# Messages préremplis (paramètre text= sur wa.me). Optionnel : sinon textes par défaut dans le code.
# VITE_ONEJOB_WHATSAPP_PREFILL_FORM=
# VITE_ONEJOB_WHATSAPP_PREFILL_ADE_1=
# VITE_ONEJOB_WHATSAPP_PREFILL_ADE_2=

# Vercel uniquement (fonction serverless api/paydunia/hasPaied.js) : URL du webhook PayDunya sur le backend (legacy).
# Ex. https://ton-backend.vercel.app/api/webhooks/paydunya
# JOBETU_PAYDUNYA_WEBHOOK_TARGET=
